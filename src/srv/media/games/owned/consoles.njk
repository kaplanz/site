---
title: "Games: Consoles"
---

{% include "media/navbar.njk" %}
{% include "games/navbar.njk" %}

<table class="plain">
  <thead>
    <tr>
      <th></th>
      <th></th>
      <th>Title</th>
      <th>Model</th>
    </tr>
  </thead>
  <tbody>
    {% for item in fetch.games.consoles
      | sort(false, false, "title")
      | sort(false, false, "model")
      | sort(false, false, "platform.date")
      %}
      <tr>
        <td class="icon">
          {% if item.platform.name -%}
            <img src="https://cdn.zakhary.dev/img/icons/retcon/{{ item.platform.slug }}.png"/>
          {%- endif %}
        </td>
        <td class="region">{{ item.region | flag }}</td>
        <td class="title">
          {{ item.title }}
          {% if item.variant -%}
            <span class="variant">({{ item.variant }})</span>
          {%- endif %}
        </td>
        <td class="model">{{ item.model }}</td>
      </tr>
    {% endfor %}
  </tbody>
</table>

<style>{% include "style/media.css" %}</style>
<style>
  table.plain {
    th, td {
      vertical-align: middle;
    }

    .icon > img {
      corner-radius: 0;
    }

    .title {
      font-family: var(--serif);
    }

    .variant {
      font-family: var(--serif);
      color: oklch(from currentColor l c h / .6);
    }

    .model {
      font: .8em var(--mono);
      color: oklch(from currentColor l c h / .6);
    }
  }
</style>
