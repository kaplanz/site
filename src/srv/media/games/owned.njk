---
title: "Games: Owned"
---

{% include "media/navbar.njk" %}
{% include "games/navbar.njk" %}

{% for system, games in fetch.games.owned
  | sort(false, false, "system.date")
  | groupby("system.slug")
  %}
  <section>
    <h3 id={{ system }} class="system">
      <a class="anchor" href="#{{ system }}">
        <img
          class="icon"
          src="https://cdn.zakhary.dev/img/icons/retcon/{{ system }}.png"
        />
        <span>{{ games[0].system.name }}</span>
      </a>
    </h3>

    <table class="plain">
      <thead>
        <tr>
          <th></th>
          <th>Title</th>
          <th>Revision</th>
        </tr>
      </thead>
      <tbody>
        {% for game in games
        | sort(false, false, "title")
        %}
          <tr>
            <td class="region">{{ game.region | flag }}</td>
            <td class="title">{{ game.title }}</td>
            <td class="revision">{{ game.revision }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
{% endfor %}

<style>{% include "style/media.css" %}</style>
<style>
  h3.system {
    a {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    img {
      block-size: 100%;
      corner-radius: 0;
    }
  }

  table.plain {
    th, td {
      vertical-align: middle;
    }

    .title {
      font-family: var(--serif);
    }

    .revision {
      font: .8em var(--mono);
      color: oklch(from currentColor l c h / .6);
    }

    .system {
      font: .8em var(--mono);
      background: oklch(from var(--teal) l c h / .4);
      border-radius: 4px;
      padding: 0 4px;
    }
  }
</style>
