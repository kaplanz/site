---
title: Media
about: >
  Books, games, films, shows, and links I've been into recently.
---

{% include "media/navbar.njk" %}

<p>{{ about }}</p>

<ul class="feed">
  {% for item in media | sort(reverse=true, attribute="meta.created") %}
    <li>
      <a
        class="kind {{ item.kind }}"
        href="/media/{{ item.kind }}s"
      >{{ item.kind }}</a>
      <span class="title">
        {%- if item.kind == "link" -%}
          <a
            href="{{ item.item.url }}"
            target="_blank"
          >{{ item.item.title or item.item.url }}</a>
        {%- else -%}
          {{ item.item.title }}
        {%- endif -%}
      </span>
      {% set date = item.meta.created %}
      <time
        datetime="{{ date | dated }}"
        title="{{ date | dated }}"
      >{{ date | since }}</time>
    </li>
  {% endfor %}
</ul>

<style>{% include "style/media.css" %}</style>
<style>
  ul.feed {
    list-style: none;
    padding: 0;
    margin: 1em 0;
    display: flex;
    flex-direction: column;
    gap: .25em;

    li {
      display: flex;
      align-items: baseline;
      gap: 1ch;
      padding-block: 4px;
      border-block-end: 1px solid oklch(from currentColor l c h / .1);

      .title {
        font-family: var(--serif);
        flex: 1;
        min-inline-size: 0;
        overflow-wrap: break-word;
      }

      time {
        font: .8em var(--mono);
        color: oklch(from currentColor l c h / .6);
      }
    }
  }
</style>
